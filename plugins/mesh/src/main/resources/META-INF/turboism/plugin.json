{
  "format": "turboism.plugin.meta",
  "schemaVersion": 2,
  "id": "dev.turboism.plugin.mesh",
  "name": "Mesh Inspector and Mirror-Axis Tools",
  "version": "0.1.0",
  "description": "Inspects mesh/deformer state and contributes the bounded mirror-axis rotation control for verified Cubism hosts.",
  "entrypoints": [
    "dev.turboism.plugin.mesh.MeshPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["base", "en", "ja", "ko", "zh_Hans", "zh_Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Read mesh and deformer snapshots for the inspector."
    },
    {
      "id": "turboism.ui.context-source.read",
      "scope": "application",
      "reason": "Read typed context source for inspect context."
    },
    {
      "id": "turboism.ui.status.notify",
      "scope": "application",
      "reason": "Notify inspect results and empty fallback."
    },
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Register the mesh inspect action."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Changes the current mesh mirror-axis tool angle."
    },
    {
      "id": "turboism.ui.panel.contribute",
      "scope": "application",
      "reason": "Contributes the mirror-axis angle control to Cubism's mesh editor."
    }
  ],
  "capabilities": [
    "cubism.mesh.read",
    "cubism.deformer.read",
    "cubism.mesh.mirror-axis-angle",
    "ui.mesh-edit.mirror-axis-angle",
    "ui.context-source.read",
    "ui.status.notify"
  ],
  "environment": {
    "requiresCubism": true,
    "ui": "embedded"
  }
}
