{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.selection-brush",
  "name": "Selection Brush",
  "version": "0.1.0",
  "description": "Selects ArtMesh vertices and Warp Deformer control points in verified modeling and mesh modes.",
  "entrypoints": [
    "dev.turboism.plugin.selectionbrush.SelectionBrushPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    {
      "name": "Turboism Contributors"
    }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [
    "icons/"
  ],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": [
      "en",
      "ja",
      "ko",
      "zh-Hans",
      "zh-Hant"
    ]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.ui.toolbar.mesh.contribute",
      "scope": "application",
      "reason": "Contributes the Selection Brush button and radius slider to the mesh toolbar."
    },
    {
      "id": "turboism.ui.toolbar.main.contribute",
      "scope": "application",
      "reason": "Contributes the ordinary Selection Brush beside the native brush selection tool."
    },
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Reads current editable ArtMesh vertices and Warp Deformer control points for brush hit testing."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Updates native point selection without changing authored geometry; ordinary mode follows native selection history."
    }
  ],
  "capabilities": [
    "cubism.mesh.custom-tools",
    "cubism.modeling.custom-tools"
  ],
  "environment": {
    "requiresCubism": true,
    "ui": "embedded"
  },
  "tags": [
    "mesh",
    "selection",
    "brush"
  ],
  "category": "modeling"
}
