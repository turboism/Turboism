{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.perfopt",
  "name": "Performance Overlay Plugin",
  "version": "0.1.0",
  "description": "FPS overlay toggle action/menu and lifecycle provider shell.",
  "entrypoints": [
    "dev.turboism.plugin.perfopt.PerfOptPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["en", "ja", "ko", "zh-Hans", "zh-Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Registers the FPS overlay toggle action."
    },
    {
      "id": "turboism.ui.menu.contribute",
      "scope": "application",
      "reason": "Adds the FPS overlay toggle to the Performance menu."
    },
    {
      "id": "turboism.config.plugin.read",
      "scope": "application",
      "reason": "Restores the inert B1 FPS presentation preference."
    },
    {
      "id": "turboism.config.plugin.write",
      "scope": "application",
      "reason": "Persists the inert B1 FPS presentation preference."
    }
  ],
  "capabilities": [],
  "environment": {
    "requiresCubism": false,
    "ui": "none"
  },
  "tags": [
    "optimization",
    "runtime",
    "latency"
  ],
  "category": "performance"
}
