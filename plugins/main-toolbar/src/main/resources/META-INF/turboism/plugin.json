{
  "format": "turboism.plugin.meta",
  "schemaVersion": 2,
  "id": "dev.turboism.plugin.maintoolbar",
  "name": "Main Toolbar Plugin",
  "version": "0.1.0",
  "description": "SDK-only Turboism panel and main toolbar settings entry through typed UI services.",
  "entrypoints": [
    "dev.turboism.plugin.maintoolbar.MainToolbarPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": ["icons/"],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["base", "en", "ja", "ko", "zh_Hans", "zh_Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Registers the main toolbar home entry action."
    },
    {
      "id": "turboism.ui.toolbar.main.contribute",
      "scope": "application",
      "reason": "Adds the home entry button to the main toolbar."
    },
    {
      "id": "turboism.ui.panel.contribute",
      "scope": "application",
      "reason": "Publishes and activates the Turboism embedded panel."
    }
  ],
  "capabilities": [],
  "environment": {
    "requiresCubism": false,
    "ui": "none"
  }
}
