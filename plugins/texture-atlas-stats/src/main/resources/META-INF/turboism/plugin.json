{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.texture-atlas-stats",
  "name": "Texture Atlas Statistics",
  "version": "0.68.0",
  "description": "Shows the total and current-texture model-image counts in the native texture-atlas editor window.",
  "entrypoints": [
    "dev.turboism.plugin.textureatlasstats.TextureAtlasStatisticsPlugin"
  ],
  "turboismApi": "[0.70.0,)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["en", "ja", "ko", "zh-Hans", "zh-Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Read model-image counts from the active texture-atlas editor session."
    },
    {
      "id": "turboism.ui.panel.contribute",
      "scope": "application",
      "reason": "Attach the statistics line to the native texture-atlas editor window."
    }
  ],
  "capabilities": ["cubism.texture-atlas.statistics", "ui.host-view-panel.contribute"],
  "environment": {
    "requiresCubism": true,
    "ui": "swing"
  },
  "lifecycle": {
    "hotReload": true
  },
  "tags": [
    "texture-atlas",
    "metrics",
    "inspection"
  ],
  "category": "analysis"
}
