{
  "format": "turboism.plugin.meta",
  "schemaVersion": 2,
  "id": "dev.turboism.plugin.logfilter",
  "name": "Log Filter Plugin",
  "version": "0.1.0",
  "description": "SDK-only log palette toolbar filtering through Turboism UI host services.",
  "entrypoints": [
    "dev.turboism.plugin.logfilter.LogFilterPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": ["icons/"],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["en", "ja", "ko", "zh-Hans", "zh-Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Registers the log filter level toggle action."
    },
    {
      "id": "turboism.ui.toolbar.palette.contribute",
      "scope": "application",
      "reason": "Adds the log filter toggle to the LOG palette toolbar."
    },
    {
      "id": "turboism.ui.status.notify",
      "scope": "application",
      "reason": "Shows filter-level and fallback status notifications."
    },
    {
      "id": "turboism.config.plugin.read",
      "scope": "application",
      "reason": "Restores validated B1 log-filter settings."
    },
    {
      "id": "turboism.config.plugin.write",
      "scope": "application",
      "reason": "Persists validated B1 log-filter settings."
    }
  ],
  "capabilities": [],
  "environment": {
    "requiresCubism": false,
    "ui": "none"
  }
}
