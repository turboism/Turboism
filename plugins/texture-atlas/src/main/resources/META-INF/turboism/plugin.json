{
  "format": "turboism.plugin.meta",
  "schemaVersion": 2,
  "id": "dev.turboism.plugin.texture-atlas",
  "name": "MaxRects-BSSF Layout Algorithm",
  "version": "0.1.0",
  "description": "Registers the MaxRects-BSSF texture-atlas packing algorithm with parallel search.",
  "entrypoints": [
    "dev.turboism.plugin.textureatlas.TextureAtlasPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["base", "en", "ja", "ko", "zh_Hans", "zh_Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Read the complete active texture-atlas authoring snapshot."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Apply a validated complete texture-atlas layout plan through Editor authoring state."
    },
    {
      "id": "turboism.config.plugin.read",
      "scope": "application",
      "reason": "Restore the selected automatic texture-atlas layout mode."
    },
    {
      "id": "turboism.config.plugin.write",
      "scope": "application",
      "reason": "Persist the selected automatic texture-atlas layout mode."
    }
  ],
  "capabilities": ["cubism.texture-atlas.layout"],
  "environment": {
    "requiresCubism": true,
    "ui": "none"
  }
}
