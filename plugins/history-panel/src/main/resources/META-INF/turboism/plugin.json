{
  "format": "turboism.plugin.meta",
  "schemaVersion": 2,
  "id": "dev.turboism.plugin.historypanel",
  "name": "History Panel Plugin",
  "version": "0.1.0",
  "description": "Read-only Photoshop-style history pane: projects the active document's native Undo history into an embedded dock tab. Move-to stays fail-closed in production.",
  "entrypoints": [
    "dev.turboism.plugin.historypanel.HistoryPanelPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    {
      "name": "Turboism Contributors"
    }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [
    "icons/"
  ],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": [
      "en",
      "ja",
      "ko",
      "zh-Hans",
      "zh-Hant"
    ]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Read the active document's native Undo history snapshot for the pane."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Move the native Undo cursor when the user clicks a history entry (PS-style jump)."
    },
    {
      "id": "turboism.ui.panel.contribute",
      "scope": "application",
      "reason": "Contribute the History embedded dock panel."
    },
    {
      "id": "turboism.ui.toolbar.main.contribute",
      "scope": "application",
      "reason": "Attach the vertical History tool-strip button to the Cubism main frame."
    },
    {
      "id": "turboism.ui.status.notify",
      "scope": "application",
      "reason": "Notify history snapshot availability and move attempts."
    },
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Register history entry move actions for the panel."
    }
  ],
  "capabilities": [
    "cubism.editor-history.read",
    "cubism.editor-history.move",
    "ui.embedded-panel.contribute",
    "ui.status.notify"
  ],
  "environment": {
    "requiresCubism": false,
    "ui": "embedded"
  }
}
