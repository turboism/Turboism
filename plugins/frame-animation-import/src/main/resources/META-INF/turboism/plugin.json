{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.frame-animation-import",
  "name": "Frame Animation Import",
  "version": "0.1.0",
  "description": "Import sequence frame animations from sprite sheets or image lists and bind to parameters with keyframe visibility.",
  "entrypoints": [
    "dev.turboism.plugin.frameanimation.FrameAnimationImportPlugin"
  ],
  "turboismApi": "[0.67.0,1.0.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["en", "ja", "ko", "zh-Hans", "zh-Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Read model parts, drawables, and parameter definitions."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Create frame animation parts, art meshes, parameters, and bind keyframe opacities."
    },
    {
      "id": "turboism.file.read",
      "scope": "application",
      "reason": "Read selected frame images and sprite sheet files."
    },
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Register frame animation import action."
    },
    {
      "id": "turboism.ui.context-menu.contribute",
      "scope": "application",
      "reason": "Expose frame animation import in the Part tab context menu."
    },
    {
      "id": "turboism.ui.menu.contribute",
      "scope": "application",
      "reason": "Adds the frame animation import launcher to the Turboism top-level menu."
    },
    {
      "id": "turboism.ui.status.notify",
      "scope": "application",
      "reason": "Notify import outcomes and validation errors."
    }
  ],
  "capabilities": [
    "cubism.model.read",
    "cubism.model.write",
    "cubism.parameter.write",
    "ui.context-menu.contribute",
    "ui.menu.contribute",
    "ui.status.notify"
  ],
  "environment": {
    "requiresCubism": true,
    "ui": "swing"
  },
  "lifecycle": {
    "hotReload": true
  },
  "tags": [
    "animation",
    "frame-animation",
    "sprite-sheet",
    "parameter"
  ],
  "category": "modeling"
}
