{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.turbo-mesh",
  "name": "Turbo Mesh",
  "version": "0.1.0",
  "description": "Custom ArtMesh point placement: curvature-aware boundary resampling, autonomous region subdivision and constrained Delaunay triangulation, committed as one undoable edit.",
  "entrypoints": [
    "dev.turboism.plugin.turbomesh.TurboMeshPlugin"
  ],
  "turboismApi": "[0.68.1,1.0.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["en", "ja", "ko", "zh-Hans", "zh-Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Read the selected ArtMesh geometry for placement planning."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Commit the generated mesh geometry back to the ArtMesh."
    },
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Register the custom placement action."
    },
    {
      "id": "turboism.ui.context-menu.contribute",
      "scope": "application",
      "reason": "Contribute the placement entry to ArtMesh context menus."
    },
    {
      "id": "turboism.ui.dialog.contribute",
      "scope": "application",
      "reason": "Show the placement mode chooser and the before/after confirmation dialog."
    },
    {
      "id": "turboism.ui.status.notify",
      "scope": "application",
      "reason": "Report placement results and failures."
    },
    {
      "id": "turboism.cubism.mesh.automesh.contribute",
      "scope": "application",
      "reason": "Offer the region and adaptive placement algorithms in the Editor's Auto Mesh Generate entry."
    }
  ],
  "capabilities": [
    "cubism.mesh.read",
    "cubism.mesh.write",
    "cubism.mesh.automesh-algorithms",
    "ui.context-menu.contribute",
    "ui.dialog.contribute",
    "ui.status.notify"
  ],
  "environment": {
    "requiresCubism": true,
    "ui": "embedded"
  },
  "tags": [
    "mesh",
    "artmesh",
    "editing"
  ],
  "category": "modeling"
}
