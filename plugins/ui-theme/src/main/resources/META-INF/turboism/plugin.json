{
  "format": "turboism.plugin.meta",
  "schemaVersion": 1,
  "id": "dev.turboism.plugin.uitheme",
  "name": "UI Theme Plugin",
  "version": "0.1.0",
  "description": "Theme package management for Cubism Editor. Data-only manifest with disabled/missing fallback.",
  "entrypoints": {
    "plugin": "dev.turboism.plugin.uitheme.UiThemePlugin"
  },
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "homepage": "https://turboism.dev",
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.ui.context-menu.contribute",
      "scope": "application",
      "reason": "Adds theme management context-menu items (toggle theme, apply theme)."
    },
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Reads active model for theme configuration."
    }
  ],
  "capabilities": [],
  "environment": {
    "requiresCubism": false,
    "ui": "none"
  }
}
