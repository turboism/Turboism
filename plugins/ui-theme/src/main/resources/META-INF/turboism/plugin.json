{
  "format": "turboism.plugin.meta",
  "schemaVersion": 2,
  "id": "dev.turboism.plugin.uitheme",
  "name": "UI Theme Plugin",
  "version": "0.1.0",
  "description": "SDK-only UI theme package and status behavior through Turboism read and UI host services. Production host theme mutation remains disabled.",
  "entrypoints": [
    "dev.turboism.plugin.uitheme.UiThemePlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": ["themes/"],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": []
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Registers theme package status and import actions."
    },
    {
      "id": "turboism.ui.context-menu.contribute",
      "scope": "application",
      "reason": "Adds theme management context-menu items."
    },
    {
      "id": "turboism.cubism.project.read",
      "scope": "application",
      "reason": "Reads the SDK theme status snapshot through the project-scoped Cubism read capability."
    },
    {
      "id": "turboism.ui.dialog.contribute",
      "scope": "application",
      "reason": "Shows the fake-host theme package import confirmation dialog."
    },
    {
      "id": "turboism.ui.file-chooser.request",
      "scope": "application",
      "reason": "Requests a ZIP theme package path for the fake-host import workflow."
    },
    {
      "id": "turboism.ui.status.notify",
      "scope": "application",
      "reason": "Shows theme package status and import progress notifications."
    }
  ],
  "capabilities": [],
  "environment": {
    "requiresCubism": false,
    "ui": "none"
  }
}
