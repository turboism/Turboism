{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.model-import-3d",
  "name": "3D Model Import",
  "version": "0.1.0",
  "description": "Imports static opaque GLB, glTF, OBJ/MTL, and model ZIP packages as native Cubism meshes with PNG/JPEG base-color textures, XYZ full-circle rotation, and bounded geometry optimization.",
  "entrypoints": [
    "dev.turboism.validation.modelimport3d.host.ModelImportPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    {
      "name": "Turboism Contributors"
    }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": [
      "en",
      "ja",
      "ko",
      "zh-Hans",
      "zh-Hant"
    ]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Registers the 3D model import action."
    },
    {
      "id": "turboism.ui.menu.contribute",
      "scope": "application",
      "reason": "Contributes the 3D model import menu item."
    },
    {
      "id": "turboism.ui.file-chooser.request",
      "scope": "application",
      "reason": "Requests user selection of a GLB, glTF, OBJ, or model ZIP file."
    },
    {
      "id": "turboism.file.read",
      "scope": "application",
      "reason": "Reads the user-selected model file and referenced textures."
    },
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Inspects the active model and parameters."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Creates model meshes and parameters in a single undoable transaction."
    }
  ],
  "capabilities": [],
  "environment": {
    "requiresCubism": true,
    "ui": "embedded"
  },
  "lifecycle": {
    "hotReload": true
  },
  "category": "workflow",
  "tags": [
    "3d",
    "glb",
    "gltf",
    "obj",
    "import"
  ]
}
