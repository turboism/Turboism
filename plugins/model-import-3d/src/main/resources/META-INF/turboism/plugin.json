{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.model-import-3d",
  "name": "3D 模型导入",
  "version": "0.1.0",
  "description": "静态不透明 GLB、glTF、OBJ/MTL 与 ZIP 原生导入；支持 PNG/JPEG 基础色贴图、XYZ 整圈旋转及有界几何优化。",
  "entrypoints": [
    "dev.turboism.validation.modelimport3d.host.ModelImportPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    {
      "name": "Turboism Contributors"
    }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": [
      "en",
      "ja",
      "ko",
      "zh-Hans",
      "zh-Hant"
    ]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "注册用户导入操作"
    },
    {
      "id": "turboism.ui.menu.contribute",
      "scope": "application",
      "reason": "提供模型导入菜单"
    },
    {
      "id": "turboism.ui.file-chooser.request",
      "scope": "application",
      "reason": "请求用户选择 GLB、glTF、OBJ 或模型 ZIP"
    },
    {
      "id": "turboism.file.read",
      "scope": "application",
      "reason": "读取用户所选模型文件及包内贴图"
    },
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "检查当前模型及参数"
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "以单个可撤销事务创建模型及参数"
    }
  ],
  "capabilities": [],
  "environment": {
    "requiresCubism": true,
    "ui": "embedded"
  },
  "category": "workflow",
  "tags": [
    "3d",
    "glb",
    "gltf",
    "obj",
    "import"
  ]
}
