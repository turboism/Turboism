{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.demo",
  "name": "Demo Plugin",
  "version": "0.1.0",
  "description": "Demo plugin for Turboism framework validation.",
  "entrypoints": [
    "dev.turboism.plugin.demo.DemoPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    {
      "name": "Turboism Contributors"
    }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["en", "ja", "ko", "zh-Hans", "zh-Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.ui.menu",
      "scope": "application",
      "reason": "Adds a demo menu item."
    },
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Registers the demo hello action."
    },
    {
      "id": "turboism.ui.menu.contribute",
      "scope": "application",
      "reason": "Contributes a demo menu item."
    },
    {
      "id": "turboism.ui.toolbar.main.contribute",
      "scope": "application",
      "reason": "Contributes a demo main toolbar button."
    },
    {
      "id": "turboism.ui.toolbar.palette.contribute",
      "scope": "application",
      "reason": "Contributes a demo palette toolbar button."
    },
    {
      "id": "turboism.ui.context-menu.contribute",
      "scope": "application",
      "reason": "Contributes a demo context menu entry."
    },
    {
      "id": "turboism.config.plugin.read",
      "scope": "application",
      "reason": "Reads demo plugin configuration."
    },
    {
      "id": "turboism.event.subscribe",
      "scope": "application",
      "reason": "Subscribes to demo events."
    },
    {
      "id": "turboism.event.publish",
      "scope": "application",
      "reason": "Publishes demo events."
    }
  ],
  "capabilities": [],
  "environment": {
    "requiresCubism": false,
    "ui": "none"
  },
  "tags": [
    "example",
    "sdk"
  ],
  "category": "development"
}
