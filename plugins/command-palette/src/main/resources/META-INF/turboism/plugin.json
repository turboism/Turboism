{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.command-palette",
  "name": "Command Palette",
  "version": "0.1.0",
  "description": "Ctrl+K command launcher over the supported Cubism Editor menu commands, searchable by command id or localized name.",
  "entrypoints": [
    "dev.turboism.plugin.commandpalette.CommandPalettePlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    {
      "name": "Turboism Contributors"
    }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["en", "ja", "ko", "zh-Hans", "zh-Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Registers the Command Palette open action and its default Ctrl+K shortcut."
    },
    {
      "id": "turboism.ui.menu.contribute",
      "scope": "application",
      "reason": "Adds the Command Palette entry to the Turboism top-level menu."
    },
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Executes read-tier Editor commands chosen in the palette."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Executes write-tier Editor commands chosen in the palette."
    },
    {
      "id": "turboism.file.write",
      "scope": "application",
      "reason": "Allows the SAVE Editor command to be launched from the palette."
    },
    {
      "id": "turboism.network.fetch",
      "scope": "application",
      "reason": "Allows the palette to launch Editor commands that open Live2D web pages."
    },
    {
      "id": "turboism.process.run",
      "scope": "application",
      "reason": "Allows the palette to launch Editor commands that open local folders."
    }
  ],
  "capabilities": [
    "cubism.editor-commands.execute"
  ],
  "environment": {
    "requiresCubism": true,
    "ui": "swing"
  },
  "tags": [
    "launcher",
    "commands",
    "shortcut"
  ],
  "category": "workflow"
}
