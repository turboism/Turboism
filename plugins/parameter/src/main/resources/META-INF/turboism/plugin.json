{
  "format": "turboism.plugin.meta",
  "schemaVersion": 2,
  "id": "dev.turboism.plugin.parameter",
  "name": "Parameter Tools Plugin",
  "version": "0.1.0",
  "description": "Parameter CSV import/export plus typed batch binding inversion and transfer workflows.",
  "entrypoints": [
    "dev.turboism.plugin.parameter.ParameterPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["en", "ja", "ko", "zh-Hans", "zh-Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Read parameter snapshots, selection, and binding state for CSV and batch workflows."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Apply parameter values and confirmed binding inversion/transfer through typed Editor authoring APIs."
    },
    {
      "id": "turboism.ui.file-chooser.request",
      "scope": "application",
      "reason": "Choose CSV files for import."
    },
    {
      "id": "turboism.ui.status.notify",
      "scope": "application",
      "reason": "Notify export/import results and fallbacks."
    },
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Register parameter CSV, binding inversion, and binding transfer actions."
    },
    {
      "id": "turboism.ui.menu.contribute",
      "scope": "application",
      "reason": "Expose parameter binding inversion and transfer through the Parameter Tools menu."
    },
    {
      "id": "turboism.ui.context-menu.contribute",
      "scope": "application",
      "reason": "Expose typed parameter binding inversion and transfer in supported Editor context menus."
    }
  ],
  "capabilities": [
    "cubism.parameter.read",
    "cubism.parameter.write",
    "cubism.parameter.bindings.invert",
    "cubism.parameter.bindings.transfer",
    "ui.context-menu.contribute",
    "ui.file-chooser.request",
    "ui.status.notify"
  ],
  "environment": {
    "requiresCubism": true,
    "ui": "embedded"
  }
}
