{
  "format": "turboism.plugin.meta",
  "schemaVersion": 3,
  "id": "dev.turboism.plugin.parameter-batch-transfer",
  "name": "Parameter Batch Transfer",
  "version": "0.1.0",
  "description": "Batch-transfer parameter bindings of one ArtMesh or Deformer to other parameters, with optional inversion, through a modal dialog.",
  "entrypoints": [
    "dev.turboism.plugin.parameterbatchtransfer.ParameterBatchTransferPlugin"
  ],
  "turboismApi": "[0.1.0,0.2.0)",
  "authors": [
    { "name": "Turboism Contributors" }
  ],
  "license": "Project License",
  "website": "https://turboism.dev",
  "resources": [],
  "i18n": {
    "baseName": "META-INF/turboism/i18n/messages",
    "locales": ["en", "ja", "ko", "zh-Hans", "zh-Hant"]
  },
  "dependencies": [],
  "permissions": [
    {
      "id": "turboism.cubism.model.read",
      "scope": "application",
      "reason": "Read the selected object's parameter bindings and the model parameter list for the transfer session."
    },
    {
      "id": "turboism.cubism.model.write",
      "scope": "application",
      "reason": "Apply confirmed parameter-binding transfers through the typed Editor authoring API."
    },
    {
      "id": "turboism.action.register",
      "scope": "application",
      "reason": "Register the batch-transfer open action behind the context-menu entries."
    },
    {
      "id": "turboism.ui.context-menu.contribute",
      "scope": "application",
      "reason": "Expose the batch-transfer entry in Deformer tab, Part tab, and workspace object context menus."
    },
    {
      "id": "turboism.ui.status.notify",
      "scope": "application",
      "reason": "Notify transfer results and precondition skips."
    }
  ],
  "capabilities": [
    "cubism.parameter.read",
    "cubism.parameter.write",
    "cubism.parameter.bindings.transfer",
    "ui.context-menu.contribute",
    "ui.status.notify"
  ],
  "environment": {
    "requiresCubism": true,
    "ui": "swing"
  },
  "tags": [
    "parameter",
    "batch-edit",
    "transfer"
  ],
  "category": "modeling"
}
