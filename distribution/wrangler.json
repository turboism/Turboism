{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turboism-release-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EDGE_DOWNLOADS_ENABLED": "true",
    "FRAMEWORK_PUBLISHER_WORKFLOW": "release-github-only.yml",
    "FRAMEWORK_PUBLISHER_ENVIRONMENT": "production-release",
    "FRAMEWORK_TRUSTED_KEYS": "{\"framework-official-v1\":\"MCowBQYDK2VwAyEA2Us4tNOgNUlDhm1mC4apjOSYAoh4q9oSlbSL4OHSDbo=\"}",
    "PLUGIN_JAR_MIRROR_ENABLED": "true"
  },
  "routes": [
    {
      "pattern": "api.turboism.dev",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "ReleaseRegistry"
      },
      {
        "name": "FRAMEWORK",
        "class_name": "FrameworkAuthority"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReleaseRegistry"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "FrameworkAuthority"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "7,22,37,52 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "turboism-downloads"
    }
  ]
}
