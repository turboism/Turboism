{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turboism-release-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.turboism.dev", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "ReleaseRegistry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReleaseRegistry"] }],
  "triggers": { "crons": ["7,22,37,52 * * * *"] },
  "observability": { "enabled": true }
}
