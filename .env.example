# Local exact-host validation configuration.
#
# Setup:
#   cp .env.example .env
#   chmod 600 .env
#   edit .env with this machine's values
#
# `.env` is ignored and rejected by repository hygiene checks. Never commit real
# usernames, hostnames, IP addresses, fixture locations, credentials, or key
# material. This template intentionally contains placeholders only.
#
# Values may be unquoted, single-quoted, or double-quoted. They are parsed as
# data (not executed as shell code). Exported variables override `.env` values.

# The Runner is local-only. It never needs SSH credentials or network access.
TURBOISM_HOST_VALIDATION_TRANSPORT=local
# Legacy SSH variables are intentionally absent; remote transport is rejected.

# Stable reviewed checkout for the opt-in systemd user service (absolute path).
# Set the real value only in your ignored .env. Quote paths containing spaces.
# Use plain KEY=value entries (no export, shell expansion or commands).
TURBOISM_HOST_VALIDATION_CHECKOUT=/path/to/turboism

# Immutable/shared local inputs and task output root.
TURBOISM_HOST_VALIDATION_GOLDEN_PREFIX=/path/to/golden-proton-prefix
TURBOISM_HOST_VALIDATION_HOST_ROOT=/path/to/TurboismValidation
TURBOISM_HOST_VALIDATION_PROTON_RUNNER=/path/to/proton

# Exact fixture paths. The SHA-256 defaults live in reviewed wrappers; override
# a hash only after independently verifying a replacement fixture.
# reviewed-fixtures:begin
TURBOISM_HOST_VALIDATION_FIXTURE_5000=/path/to/cubism-5.0.00-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5000_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5001=/path/to/cubism-5.0.01-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5001_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5002=/path/to/cubism-5.0.02-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5002_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5003=/path/to/cubism-5.0.03-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5003_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5004=/path/to/cubism-5.0.04-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5004_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5005=/path/to/cubism-5.0.05-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5005_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5006=/path/to/cubism-5.0.06-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5006_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5100=/path/to/cubism-5.1.00-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5100_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5101=/path/to/cubism-5.1.01-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5101_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5102=/path/to/cubism-5.1.02-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5102_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5103=/path/to/cubism-5.1.03-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5103_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5200=/path/to/cubism-5.2.00-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5200_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5201=/path/to/cubism-5.2.01-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5201_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5202=/path/to/cubism-5.2.02-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5202_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5203=/path/to/cubism-5.2.03-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5203_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5300=/path/to/cubism-5.3.00-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5300_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5301=/path/to/cubism-5.3.01-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5301_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5302=/path/to/cubism-5.3.02-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5302_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5303=/path/to/cubism-5.3.03-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5303_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_5304=/path/to/cubism-5.3.04-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5304_SHA256=<64 lowercase hex characters>
# reviewed-fixtures:end

# Separately checked-out licensed Cubism binary evidence for the explicit
# :runtime:legacyCubismEvidenceTest host-verification lane. Ordinary builds,
# checkCompletedCommit, checkRelease, and public release CI do not require it.
TURBOISM_LEGACY_EVIDENCE=/remote/path/to/turboism-legacy/cubism-ref

# Feature-specific fixtures.
# Pass-through variants (physics-export, broad-structure) run on a fixture that
# actually carries physics settings, morph targets and blend colors so the
# census-pinned channel is exercised on real content.
TURBOISM_HOST_VALIDATION_FIXTURE_PASSTHROUGH=/remote/path/to/feature-rich-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_PASSTHROUGH_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_PBT_5302=/remote/path/to/parameter-batch-transfer.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_PBT_5302_SHA256=<64 lowercase hex characters>
# clipmask-viewer needs a fixture with real clip-mask relationships; the shared
# versioned fixture may carry none, which terminates the probe as BLOCKED.
TURBOISM_HOST_VALIDATION_FIXTURE_CLIPMASK=/remote/path/to/clip-mask-bearing.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_CLIPMASK_SHA256=<64 lowercase hex characters>
# mcp needs a fixture with at least one Glue relation for the glue authoring
# assertions; the shared versioned fixture may carry none. When unset, the
# standard variant reuses TURBOISM_HOST_VALIDATION_FIXTURE_CLIPMASK (the
# clipmask fixture is also Glue-bearing). The free-fixture variant ignores
# both overrides and keeps the versioned selection.
TURBOISM_HOST_VALIDATION_FIXTURE_MCP=/remote/path/to/glue-bearing.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_MCP_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_PSD=/remote/path/to/clipmask.psd
TURBOISM_HOST_VALIDATION_FIXTURE_PSD_NAME=clipmask.psd
# TURBOISM_HOST_VALIDATION_FIXTURE_PSD_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_HISTORY_5302=/remote/path/to/history-fixture.cmo3
