# Local exact-host validation configuration.
#
# Setup:
#   cp .env.example .env
#   chmod 600 .env
#   edit .env with this machine's values
#
# `.env` is ignored and rejected by remote-hygiene checks. Never commit real
# usernames, hostnames, IP addresses, fixture locations, credentials, or key
# material. This template intentionally contains placeholders only.
#
# Values may be unquoted, single-quoted, or double-quoted. They are parsed as
# data (not executed as shell code). Exported variables override `.env` values.

# SSH placement for the exact-host validation machine.
TURBOISM_HOST_VALIDATION_SSH_HOST=developer@validation-host.example.invalid
TURBOISM_HOST_VALIDATION_SSH_KEY=/path/to/private/ssh/key

# Immutable/shared host inputs and task output root.
TURBOISM_HOST_VALIDATION_GOLDEN_PREFIX=/remote/path/to/golden-proton-prefix
TURBOISM_HOST_VALIDATION_REMOTE_ROOT=/remote/path/to/TurboismValidation
TURBOISM_HOST_VALIDATION_PROTON_RUNNER=/remote/path/to/proton

# Exact fixture paths. The SHA-256 defaults live in reviewed wrappers; override
# a hash only after independently verifying a replacement fixture.
TURBOISM_HOST_VALIDATION_FIXTURE_5203=/remote/path/to/cubism-5.2.03-fixture.cmo3
TURBOISM_HOST_VALIDATION_FIXTURE_5302=/remote/path/to/cubism-5.3.02-fixture.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_5203_SHA256=<64 lowercase hex characters>
# TURBOISM_HOST_VALIDATION_FIXTURE_5302_SHA256=<64 lowercase hex characters>

# Separately checked-out licensed Cubism binary evidence for the explicit
# :runtime:legacyCubismEvidenceTest host-verification lane. Ordinary builds,
# checkCompletedCommit, checkRelease, and public release CI do not require it.
TURBOISM_LEGACY_EVIDENCE=/remote/path/to/turboism-legacy/cubism-ref

# Feature-specific fixtures.
TURBOISM_HOST_VALIDATION_FIXTURE_PBT_5302=/remote/path/to/parameter-batch-transfer.cmo3
# TURBOISM_HOST_VALIDATION_FIXTURE_PBT_5302_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_PSD=/remote/path/to/clipmask.psd
TURBOISM_HOST_VALIDATION_FIXTURE_PSD_NAME=clipmask.psd
# TURBOISM_HOST_VALIDATION_FIXTURE_PSD_SHA256=<64 lowercase hex characters>
TURBOISM_HOST_VALIDATION_FIXTURE_HISTORY_5302=/remote/path/to/history-fixture.cmo3
